{
  "name": "@crinkles/digl",
  "version": "3.0.0",
  "description": "Autolayout graphs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "typecheck": "tsc",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "format": "prettier --write .",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecrinkles/digl.git"
  },
  "keywords": [
    "graph",
    "directed graph",
    "layout algorithm"
  ],
  "author": "Kevin Pennekamp <github@crinkles.io>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thecrinkles/digl/issues"
  },
  "homepage": "https://github.com/thecrinkles/digl#readme",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
