{
  "include": ["src"],
  "compilerOptions": {
    "lib": ["es2019"],
    "target": "es2019",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "removeComments": true,
    "types": ["jest"]
  }
}
